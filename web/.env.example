# API base。去掉 base 之後的路徑（/quiz/*、/vocabulary/*、/stats）兩邊一致。
#
# 本機開發：走 Next 的同源轉送，由 next.config.ts 轉給 Python 後端。
NEXT_PUBLIC_API_BASE=/api/backend/toeic
#
# 直接打 Python 後端也可以，但 backend/app/main.py 的 CORS 白名單只放了
# http://localhost:5173，Next dev 不是那個埠號，瀏覽器會擋下回應。
# 要用這個值就得把 Next dev 起在 5173。
# NEXT_PUBLIC_API_BASE=http://localhost:8003/api
#
# 上線接 Go（dashai-go 的 /toeic）：
# NEXT_PUBLIC_API_BASE=/api/backend/toeic

# 同源轉送的目標與路徑前綴，只在本機開發用得到。
# Go（dashai-go 的 toeic module）
DEV_BACKEND_ORIGIN=http://localhost:8010
DEV_BACKEND_PREFIX=/toeic
# 舊的 Python 後端拿來對照時改成這兩行
# DEV_BACKEND_ORIGIN=http://localhost:8003
# DEV_BACKEND_PREFIX=/api
