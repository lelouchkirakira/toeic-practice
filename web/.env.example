# 瀏覽器打的同源路徑，本機與上線一致。
NEXT_PUBLIC_API_BASE=/api/backend/toeic

# 以下是伺服器端變數，不會進前端 bundle。
# 後端位址。本機跑 dashai-go 用 8010，上線是 Render。
TOEIC_BACKEND_ORIGIN=http://localhost:8010

# dashai-go 的 origin lock 金鑰。本機的 dashai-go 沒開 enforce 所以不用設，
# 上線一定要設，否則後端一律回 403。
# ORIGIN_KEY=

# Sentry。DSN 依 Sentry 的定義是公開值，實際值見 Vercel 專案設定。
NEXT_PUBLIC_SENTRY_DSN=
