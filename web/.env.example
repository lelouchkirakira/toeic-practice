# 瀏覽器打的同源路徑，本機與上線一致。
NEXT_PUBLIC_API_BASE=/api/backend/toeic

# 以下是伺服器端變數，不會進前端 bundle。
# 後端位址。本機跑 dashai-go 用 8010，上線是 Render。
TOEIC_BACKEND_ORIGIN=http://localhost:8010

# dashai-go 的 origin lock 金鑰。本機的 dashai-go 沒開 enforce 所以不用設，
# 上線一定要設，否則後端一律回 403。
# ORIGIN_KEY=

# Sentry。DSN 依 Sentry 的定義是公開值，實際值見 Vercel 專案設定。
NEXT_PUBLIC_SENTRY_DSN=

# 預先產生的單字發音（Google Cloud TTS 產生，存在 Vercel Blob）。
# 沒設這個值時前端會退回瀏覽器內建語音。
NEXT_PUBLIC_WORD_AUDIO_BASE=https://sp1vz5mua9vmz9jf.public.blob.vercel-storage.com/words

# 已備妥音檔的口音，逗號分隔。男聲加 -m 後綴，2026-09-21 撤掉改留備份。
NEXT_PUBLIC_ENABLED_ACCENTS=us,gb,au

# 例句朗讀（美式女聲一種）。沒設就不顯示例句的播放鍵。
NEXT_PUBLIC_EXAMPLE_AUDIO_BASE=https://sp1vz5mua9vmz9jf.public.blob.vercel-storage.com/examples

# 音檔的根位址。單字在 /words 底下，聽力在 /part2 /part3 /part4 底下。
NEXT_PUBLIC_BLOB_BASE=https://sp1vz5mua9vmz9jf.public.blob.vercel-storage.com
